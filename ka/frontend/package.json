{
  "name": "krishiassist-frontend",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "test:i18n": "tsc -p tsconfig.test.json && node scripts/mark-commonjs.mjs && node --test tests/i18n.test.mjs",
    "check:i18n": "npm run i18n:audit && npm run test:i18n"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
